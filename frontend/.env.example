# ================================================
# Sanity CMS Configuration
# ================================================
# Get these from: https://sanity.io/manage → Your Project → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR_SANITY_PROJECT_ID
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: For server-side authenticated requests (e.g., ISR/SSG)
# Create a token at: Sanity Dashboard → API → Tokens → Add API Token (Viewer)
SANITY_API_TOKEN=

# ================================================
# Site Configuration
# ================================================
NEXT_PUBLIC_SITE_NAME=School Website
NEXT_PUBLIC_SITE_URL=https://yourschool.vercel.app

# ================================================
# WhatsApp Integration
# ================================================
# Phone number with country code, no +, no spaces (e.g., 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ================================================
# IMPORTANT: CORS Setup
# ================================================
# After setting up Sanity project, add your frontend URL to CORS origins:
# Sanity Dashboard → API → CORS Origins → Add: http://localhost:3000, https://yoursite.vercel.app
